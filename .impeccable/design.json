  "narrative": {
    "northStar": "Engineering Wayfinding",
    "overview": "Engineering Wayfinding pairs broad, compact headlines with narrower body text and large, flat color fields. Its confidence comes from scale, alignment, and visible destinations. Recruiters can scan engineering work without waiting for entrance effects.\n\nThe system is precise and readable, with restrained motion and square controls. Light and dark themes share the yellow destinations and contact field, maintaining a clear point of recognition.",
    "keyCharacteristics": [
      "Flat pale-blue, deep-ink, and yellow fields.",
      "Self-hosted Epilogue display type with Barlow titles and body.",
      "Directional links, hairline rules, and square controls.",
      "Responsive reading order with visible content from first paint."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Yellow marks prominent destination and contact fields; keep dark ink text on these fields in both themes.",
        "section": "colors"
      },
      {
        "name": "The Flat Field Rule",
        "body": "Use color fields, rules, and type hierarchy to separate content; do not add decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing light and dark semantic color assignments.",
      "Do preserve readable source order when columns stack.",
      "Do include visible keyboard focus and honor reduced motion.",
      "Do retain the distinction between large current-project titles and compact earlier-project rows."
    ],
    "donts": [
      "Don't introduce rounded cards or decorative shadows into this flat system.",
      "Don't hide essential content behind entrance animation.",
      "Don't replace the self-hosted type pairing with a generic font stack.",
      "Don't invent project screenshots, metrics, or external project links."
    ]
  }
}
